# ---------------------------------------------------------------------------
# RAG Research Assistant - example configuration
#
# Copy to .env and edit. Every value here is a placeholder; the file contains
# no real credentials and must never be given any.
#
# Nesting uses a double underscore: RAG_RETRIEVAL__TOP_K sets retrieval.top_k.
# ---------------------------------------------------------------------------

# local | test | staging | production
# 'production' enforces extra invariants at startup and refuses to serve if the
# configuration is unsafe for it.
RAG_ENVIRONMENT=local

# --- Security ---------------------------------------------------------------
RAG_SECURITY__REQUIRE_API_KEY=true
# Comma-separated. Use "tenant:secret" to bind a key to a tenant; a bare secret
# is bound to the "default" tenant. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_SECURITY__API_KEYS=acme:REPLACE_ME_WITH_A_GENERATED_KEY
# annotate | neutralise | drop - what to do with a retrieved passage that looks
# like a prompt-injection attempt.
RAG_SECURITY__INJECTION_ACTION=neutralise
# Aggregate risk at which a passage is dropped outright. Applied only when two or
# more distinct rules fired, so a document that quotes an attack is neutralised
# rather than discarded.
RAG_SECURITY__INJECTION_BLOCK_THRESHOLD=0.95
RAG_SECURITY__MAX_REQUEST_BYTES=2097152
RAG_SECURITY__MAX_QUERY_CHARS=4000

# --- Storage ----------------------------------------------------------------
# SQLite is the zero-setup default. Production requires PostgreSQL and startup
# will refuse a SQLite URL when RAG_ENVIRONMENT=production.
RAG_STORAGE__DATABASE_URL=sqlite+pysqlite:///./var/rag.db
# RAG_STORAGE__DATABASE_URL=postgresql+psycopg://rag:REPLACE_ME@localhost:5432/rag
RAG_STORAGE__ECHO_SQL=false
RAG_STORAGE__POOL_SIZE=5

# --- Embeddings -------------------------------------------------------------
# hashing   - lexical only, no download, no credentials. Default; tests and first run.
# fastembed - real ONNX transformer embeddings, CPU only, no credentials. Recommended.
# ollama    - embeddings from a local Ollama server.
# openai    - any OpenAI-compatible /embeddings endpoint.
RAG_EMBEDDING__BACKEND=hashing
RAG_EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING__DIMENSIONS=384
RAG_EMBEDDING__BATCH_SIZE=32
RAG_EMBEDDING__CACHE_DIR=./var/models

# --- Generation -------------------------------------------------------------
# extractive - answers with verbatim source sentences. Default; no model needed.
# ollama     - local model, no credentials.
# openai     - any OpenAI-compatible /chat/completions endpoint.
RAG_CHAT__BACKEND=extractive
RAG_CHAT__MODEL=llama3.2:3b
RAG_CHAT__TEMPERATURE=0.0
RAG_CHAT__MAX_OUTPUT_TOKENS=800
RAG_CHAT__TIMEOUT_SECONDS=60
RAG_CHAT__MAX_RETRIES=2

# --- Providers --------------------------------------------------------------
RAG_PROVIDERS__OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_PROVIDERS__OPENAI_BASE_URL=https://api.openai.com/v1
# Leave unset unless RAG_EMBEDDING__BACKEND or RAG_CHAT__BACKEND is 'openai'.
# RAG_PROVIDERS__OPENAI_API_KEY=REPLACE_ME

# --- Ingestion --------------------------------------------------------------
RAG_INGESTION__MAX_DOCUMENT_BYTES=10485760
RAG_INGESTION__CHUNK_TARGET_TOKENS=320
RAG_INGESTION__CHUNK_OVERLAP_TOKENS=64
RAG_INGESTION__MAX_CHUNKS_PER_DOCUMENT=5000
# URL ingestion is an SSRF surface and is opt-in. Enabling it requires an
# explicit host allowlist; an empty allowlist refuses every fetch.
RAG_INGESTION__ALLOW_URL_INGESTION=false
# RAG_INGESTION__URL_ALLOWED_HOSTS=docs.example.com,arxiv.org

# --- Retrieval --------------------------------------------------------------
RAG_RETRIEVAL__TOP_K=8
RAG_RETRIEVAL__DENSE_CANDIDATES=40
RAG_RETRIEVAL__SPARSE_CANDIDATES=40
RAG_RETRIEVAL__RRF_K=60
RAG_RETRIEVAL__ENABLE_QUERY_REWRITE=true
RAG_RETRIEVAL__ENABLE_RERANK=true
RAG_RETRIEVAL__MMR_LAMBDA=0.7
RAG_RETRIEVAL__CONTEXT_WINDOW_NEIGHBOURS=1

# --- Generation policy ------------------------------------------------------
RAG_GENERATION__MAX_CONTEXT_CHARS=24000
RAG_GENERATION__MIN_GROUNDING_SCORE=0.35
# Fraction of the query's content terms that must appear in the retrieved
# passages before a model is called. Below this the request is refused.
RAG_GENERATION__MIN_EVIDENCE_COVERAGE=0.5
RAG_GENERATION__REQUIRE_CITATIONS=true
RAG_GENERATION__REFUSE_WHEN_UNSUPPORTED=true
RAG_GENERATION__MAX_SENTENCES=4

# --- Observability ----------------------------------------------------------
RAG_OBSERVABILITY__LOG_LEVEL=INFO
RAG_OBSERVABILITY__LOG_FORMAT=json
RAG_OBSERVABILITY__SERVICE_NAME=rag-research-assistant
RAG_OBSERVABILITY__TRACING_ENABLED=false
# RAG_OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4318/v1/traces
RAG_OBSERVABILITY__TRACE_SAMPLE_RATIO=1.0
# Off by default: document and query text is user data.
RAG_OBSERVABILITY__LOG_DOCUMENT_CONTENT=false
