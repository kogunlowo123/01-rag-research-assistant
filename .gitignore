# evaluation dataset and its corpus are part of the repository, and an
# over-broad 'data/' rule silently excluded them once already.
var/
*.db
*.sqlite
*.sqlite3
*.log

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build artifacts
*.sarif
sbom.json
